<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>多功能智慧行事曆</title>
  <style>
    :root {
      --primary-color: #4A90E2;
      --success-color: #2ECC71;
      --warning-color: #E74C3C;
      --bg-color: #F5F7FA;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-color);
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    .calendar-container {
      width: 100%;
      max-width: 500px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .card {
      background: #FFFFFF;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      padding: 20px;
    }

    h2, h3 {
      margin-top: 0;
      color: #333;
    }

    /* 出門打卡卡片樣式 */
    .checkin-card {
      background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%);
      border: 1px solid #bae6fd;
    }

    .weather-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 12px 0;
      background: rgba(255, 255, 255, 0.7);
      padding: 12px;
      border-radius: 8px;
    }

    .weather-temp {
      font-size: 24px;
      font-weight: bold;
      color: #0284c7;
    }

    .outfit-recommendation {
      font-size: 14px;
      color: #334155;
      background: #ffffff;
      padding: 10px;
      border-radius: 8px;
      border-left: 4px solid #0284c7;
      margin-top: 8px;
    }

    .btn-checkin {
      background-color: var(--success-color);
      color: white;
      border: none;
      padding: 12px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      width: 100%;
      font-size: 16px;
      transition: opacity 0.2s;
    }

    .btn-checkin:hover {
      opacity: 0.9;
    }

    .btn-checkin:disabled {
      background-color: #94a3b8;
      cursor: not-allowed;
    }

    /* 行事曆與行程表單 */
    .form-group {
      margin-bottom: 12px;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
      color: #555;
      font-size: 14px;
    }

    input, select {
      width: 100%;
      padding: 10px;
      border: 1px solid #DDD;
      border-radius: 6px;
      box-sizing: border-box;
      font-size: 14px;
    }

    .btn-primary {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 10px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      width: 100%;
    }

    .event-list {
      margin-top: 15px;
      list-style: none;
      padding: 0;
    }

    .event-item {
      background: #F9FAFB;
      border-left: 4px solid var(--primary-color);
      padding: 10px 12px;
      margin-bottom: 8px;
      border-radius: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .total-hours {
      margin-top: 10px;
      font-size: 14px;
      font-weight: bold;
      color: #333;
    }

    /* 彈窗樣式 */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.5);
      justify-content: center;
      align-items: center;
      z-index: 100;
    }

    .modal-content {
      background: white;
      padding: 20px;
      border-radius: 12px;
      text-align: center;
      max-width: 320px;
      width: 80%;
    }

    .modal-content h3 {
      margin-top: 0;
    }
  </style>
</head>
<body>

  <div class="calendar-container">
    
    <div class="card checkin-card">
      <h3>☀️ 每日出門打卡 & 天氣</h3>
      <div class="weather-info">
        <div>
          <div style="font-size: 14px; color: #64748b;">當前天氣狀況</div>
          <div id="weatherStatus" style="font-weight: bold;">讀取中...</div>
        </div>
        <div class="weather-temp" id="weatherTemp">--°C</div>
      </div>
      <div class="outfit-recommendation" id="outfitText">
        💡 穿著建議：準備載入中...
      </div>
      <br>
      <button class="btn-checkin" id="checkinBtn" onclick="doCheckin()">🚗 準備出門！立即打卡</button>
    </div>

    <div class="card">
      <h2>📅 行程安排</h2>
      
      <div class="form-group">
        <label for="eventDate">日期</label>
        <input type="date" id="eventDate">
      </div>

      <div class="form-group">
        <label for="eventTitle">行程名稱</label>
        <input type="text" id="eventTitle" placeholder="例如：開會 / 寫程式">
      </div>

      <div class="form-group">
        <label for="eventHours">預計耗時（小時）</label>
        <input type="number" id="eventHours" min="0.5" step="0.5" placeholder="例如：2">
      </div>

      <button class="btn-primary" onclick="addEvent()">新增行程</button>

      <div class="total-hours" id="totalHoursDisplay">選定日期總時數：0 小時</div>

      <ul class="event-list" id="eventList"></ul>
    </div>

  </div>

  <div class="modal-overlay" id="infoModal">
    <div class="modal-content">
      <h3 id="modalTitle">提醒</h3>
      <p id="modalBody"></p>
      <button class="btn-primary" onclick="closeModal()">我知道了</button>
    </div>
  </div>

  <script>
    // 預設日期為今天
    document.getElementById('eventDate').valueAsDate = new Date();

    const events = [];
    let currentWeather = { temp: 24, status: "多雲", rainRate: 20 }; // 預設模擬天氣數據

    // 1. 初始化天氣與穿著建議（模擬預報 API）
    function initWeather() {
      // 在實際開發中，這裡可以呼叫氣象局 API 或 OpenWeatherMap API
      // 這裡先建立智慧穿著推薦邏輯：
      const temp = currentWeather.temp;
      const status = currentWeather.status;
      let outfit = "";

      if (temp >= 28) {
        outfit = "👕 氣溫偏高，建議穿著短袖透氣衣服，注意防曬補水！";
      } else if (temp >= 20) {
        outfit = "👔 氣候舒適，建議薄長袖或短袖搭一件薄外套，方便彈性穿脫。";
      } else if (temp >= 15) {
        outfit = "🧥 氣溫偏涼，建議穿著保暖外套、長褲。";
      } else {
        outfit = "🧣 寒冷天氣，請著厚外套、圍巾等禦寒衣物。";
      }

      if (currentWeather.rainRate > 30) {
        outfit += " ☂️ 今日降雨機率較高，出門記得帶傘！";
      }

      document.getElementById('weatherStatus').innerText = status;
      document.getElementById('weatherTemp').innerText = `${temp}°C`;
      document.getElementById('outfitText').innerText = outfit;
    }

    // 2. 出門打卡功能
    function doCheckin() {
      const now = new Date();
      const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const outfitMsg = document.getElementById('outfitText').innerText;

      // 禁用按鈕防止重複打卡
      const btn = document.getElementById('checkinBtn');
      btn.innerText = `✅ 今日已打卡 (${timeString})`;
      btn.disabled = true;

      // 跳出打卡成功並溫馨提示天氣與穿著
      showModal(
        "🎉 打卡成功！順利出門",
        `打卡時間：${timeString}<br><br>${outfitMsg}<br><br>祝你有美好充實的一天！`
      );
    }

    // 3. 行程管理與 10 小時提醒
    function addEvent() {
      const date = document.getElementById('eventDate').value;
      const title = document.getElementById('eventTitle').value.trim();
      const hours = parseFloat(document.getElementById('eventHours').value);

      if (!date || !title || isNaN(hours) || hours <= 0) {
        alert("請填寫完整的行程資訊與合理的時數！");
        return;
      }

      events.push({ date, title, hours });

      document.getElementById('eventTitle').value = '';
      document.getElementById('eventHours').value = '';

      updateCalendar(date);
    }

    function updateCalendar(targetDate) {
      const listElement = document.getElementById('eventList');
      listElement.innerHTML = '';

      const dayEvents = events.filter(e => e.date === targetDate);
      const totalHours = dayEvents.reduce((sum, e) => sum + e.hours, 0);

      dayEvents.forEach(e => {
        const li = document.createElement('li');
        li.className = 'event-item';
        li.innerHTML = `<span>${e.title}</span> <b>${e.hours} 小時</b>`;
        listElement.appendChild(li);
      });

      document.getElementById('totalHoursDisplay').innerText = `選定日期總時數：${totalHours} 小時`;

      // 超過 10 小時觸發提醒
      if (totalHours > 10) {
        showModal(
          "⚠️ 溫馨提醒",
          "您今天的行程安排已經超過 <b>10 小時</b> 了！記得給自己留一點休息與充能的時間喔～ ☕"
        );
      }
    }

    document.getElementById('eventDate').addEventListener('change', (e) => {
      updateCalendar(e.target.value);
    });

    function showModal(title, htmlContent) {
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalBody').innerHTML = htmlContent;
      document.getElementById('infoModal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('infoModal').style.display = 'none';
    }

    // 頁面載入時初始化天氣
    initWeather();
  </script>
</body>
</html>
